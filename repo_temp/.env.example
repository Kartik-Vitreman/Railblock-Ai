# ==============================================================
# RAILBLOCK AI — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file to version control.
# ==============================================================

# --------------------------------------------------------------
# APPLICATION
# --------------------------------------------------------------
APP_ENV=development          # development | staging | production
APP_VERSION=0.1.0
APP_NAME="RAILBLOCK AI"
DEBUG=true

# --------------------------------------------------------------
# BACKEND — FastAPI
# --------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true          # hot-reload in development

# API versioning prefix
API_V1_STR=/api/v1

# --------------------------------------------------------------
# DATABASE — PostgreSQL
# --------------------------------------------------------------
# Full DSN used by SQLAlchemy (async driver)
DATABASE_URL=postgresql+asyncpg://railblock:changeme@localhost:5432/railblock_db

# Sync DSN used by Alembic migrations
DATABASE_SYNC_URL=postgresql+psycopg2://railblock:changeme@localhost:5432/railblock_db

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# --------------------------------------------------------------
# SECURITY
# --------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --------------------------------------------------------------
# FRONTEND — Vite
# --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME="RAILBLOCK AI"
VITE_APP_ENV=development

# --------------------------------------------------------------
# ML SERVICE (future stage)
# --------------------------------------------------------------
ML_SERVICE_URL=http://localhost:8001
ML_MODEL_PATH=./ml/models
ML_ENABLED=false

# --------------------------------------------------------------
# OPTIMIZER (future stage — OR-Tools CP-SAT)
# --------------------------------------------------------------
OPTIMIZER_TIMEOUT_SECONDS=60
OPTIMIZER_MAX_WORKERS=4
OPTIMIZER_ENABLED=false

# --------------------------------------------------------------
# SIMULATION ENGINE (future stage)
# --------------------------------------------------------------
SIMULATION_ENABLED=false
SIMULATION_SPEED_FACTOR=1.0

# --------------------------------------------------------------
# REDIS — for real-time events / caching (future stage)
# --------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# --------------------------------------------------------------
# EMAIL (future stage)
# --------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@railblock.example.com
SMTP_PASSWORD=changeme
SMTP_TLS=true

# --------------------------------------------------------------
# LOGGING
# --------------------------------------------------------------
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json              # json | text
LOG_FILE=./logs/railblock.log
